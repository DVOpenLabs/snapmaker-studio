# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.spec
.pytest_cache/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db

# Tooling / local state (never commit to the public repo)
.claude-octopus/
backend/validation/
validation/report.md
.docker/mcp/
.docker/**/mcp-toolkit.db
.docker/**/.mcp-toolkit-migration.lock

# Accidental Windows system/cache trees created by tooling/browsers
%SystemDrive%/
**/ProgramData/Microsoft/Windows/Caches/
cversions*.db
*.ver0x*.db
*.sqlite
*.sqlite3

# Local temp/cache
*.log
*.tmp
.cache/

# Local agent/tooling state (never commit to the public repo)
.claude/
.claude-flow/
.code-review-graph/
CLAUDE.md.bak-*

# Acceptance harness deps (installed on demand, never committed)
tools/acceptance/node_modules/
tools/acceptance/package-lock.json

# Real-world fixtures are fetched, never committed (AGPL + upstream privacy).
backend/tests/fixtures/real-world/

# Demo recorder deps (installed on demand, never committed)
tools/demo/node_modules/
tools/demo/package-lock.json

# Hardware verification reuses the acceptance harness deps
tools/hardware/node_modules/
tools/hardware/package-lock.json

# Tool output (profilers etc.) is never tracked
*.prof
*.pstats
prof.out
